<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="MOMO · WORD" android:textColor="#42649D" android:textSize="11sp" android:letterSpacing="0.1"/>
    <TextView android:id="@+id/widget_word" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="墨墨流云助手"
        android:textColor="#142D54" android:textStyle="bold" android:textSize="25sp"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/widget_caption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="点击开始" android:textColor="#677B92"
        android:textSize="12sp" android:layout_marginTop="6dp"/>
</LinearLayout>
